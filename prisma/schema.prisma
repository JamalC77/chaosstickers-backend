// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// EXISTING MODELS (Updated)
// ============================================

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id                Int         @id @default(autoincrement())
  userId            Int
  user              User        @relation(fields: [userId], references: [id])
  printifyOrderId   String?
  stripePaymentId   String?     @unique
  status            String      @default("pending")
  totalPaidCents    Int?        // Total amount paid by customer in cents
  printifyCostCents Int?        // Total Printify cost in cents
  // Shipping details
  shippingFirstName String?
  shippingLastName  String?
  shippingEmail     String?
  shippingPhone     String?
  shippingCountry   String?
  shippingRegion    String?
  shippingAddress1  String?
  shippingAddress2  String?
  shippingCity      String?
  shippingZip       String?
  items             OrderItem[]
  dropOrders        DropOrder[] // Link to drop orders
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id                Int      @id @default(autoincrement())
  orderId           Int
  order             Order    @relation(fields: [orderId], references: [id])
  printifyProductId String
  printifyVariantId Int
  quantity          Int      @default(1)
  imageUrl          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model GeneratedImage {
  id                   Int          @id @default(autoincrement())
  prompt               String
  imageUrl             String
  userId               String?      // Client-side UUID for anonymous users
  creatorId            Int?         // Link to creator if generated by creator
  creator              Creator?     @relation(fields: [creatorId], references: [id])
  noBackgroundUrl      String?
  hasRemovedBackground Boolean      @default(false)
  dropDesigns          DropDesign[] // Designs can be in multiple drops
  createdAt            DateTime     @default(now())
}

// ============================================
// CREATOR PLATFORM MODELS
// ============================================

model Creator {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  name            String?
  bio             String?
  profileImageUrl String?
  storeName       String    @unique  // URL slug for creator store
  styleTemplate   Json?     // Creator Style Machine configuration
  isVerified      Boolean   @default(false)
  magicLinkToken  String?   // For passwordless auth
  tokenExpiry     DateTime?
  drops           Drop[]
  earnings        Earning[]
  images          GeneratedImage[]
  notifications   NotifyMe[] @relation("CreatorNotifications")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Drop {
  id            Int          @id @default(autoincrement())
  creatorId     Int
  creator       Creator      @relation(fields: [creatorId], references: [id])
  title         String
  description   String?
  slug          String       @unique  // URL slug for drop
  coverImageUrl String?      // Hero image for drop
  status        DropStatus   @default(DRAFT)
  publishedAt   DateTime?
  expiresAt     DateTime?    // For limited-time drops
  designs       DropDesign[]
  packs         Pack[]
  orders        DropOrder[]
  notifications NotifyMe[]
  settings      Json?        // Custom pricing overrides, etc.
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum DropStatus {
  DRAFT
  PUBLISHED
  ENDED
  ARCHIVED
}

model DropDesign {
  id           Int            @id @default(autoincrement())
  dropId       Int
  drop         Drop           @relation(fields: [dropId], references: [id], onDelete: Cascade)
  imageId      Int
  image        GeneratedImage @relation(fields: [imageId], references: [id])
  displayOrder Int            @default(0)
  isHero       Boolean        @default(false)  // Featured design for drop
  createdAt    DateTime       @default(now())

  @@unique([dropId, imageId]) // Prevent duplicate designs in a drop
}

model Pack {
  id                  Int        @id @default(autoincrement())
  dropId              Int
  drop                Drop       @relation(fields: [dropId], references: [id], onDelete: Cascade)
  type                PackType
  name                String
  description         String?
  designCount         Int        // Number of designs (6, 8, 10 for build-a-pack)
  priceInCents        Int        // Pack price in cents
  printifyBlueprintId Int?       // For sticker sheets (single SKU)
  isDefault           Boolean    @default(false)
  isActive            Boolean    @default(true)
  orders              DropOrder[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

enum PackType {
  BUILD_A_PACK    // Fan picks X stickers from drop
  STICKER_SHEET   // Pre-made sheet, single SKU
  FULL_SET        // All designs in the drop
}

model DropOrder {
  id                Int      @id @default(autoincrement())
  orderId           Int
  order             Order    @relation(fields: [orderId], references: [id])
  dropId            Int
  drop              Drop     @relation(fields: [dropId], references: [id])
  packId            Int?
  pack              Pack?    @relation(fields: [packId], references: [id])
  selectedDesignIds Json     // Array of design IDs chosen by fan
  createdAt         DateTime @default(now())
}

model FanCollection {
  id             Int       @id @default(autoincrement())
  fanEmail       String
  dropId         Int
  ownedDesignIds Json      // Array of owned design IDs
  completedAt    DateTime? // When fan owns all designs in drop
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([fanEmail, dropId])
}

model Earning {
  id            Int          @id @default(autoincrement())
  creatorId     Int
  creator       Creator      @relation(fields: [creatorId], references: [id])
  orderId       Int          @unique  // One earning record per order
  grossRevenue  Int          // Total paid by customer in cents
  printifyCost  Int          // Printify production + shipping in cents
  stripeFee     Int          // Stripe processing fee in cents
  platformFee   Int          // Platform take (20% of profit) in cents
  creatorPayout Int          // Creator earnings in cents
  status        PayoutStatus @default(PENDING)
  paidAt        DateTime?
  createdAt     DateTime     @default(now())
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model NotifyMe {
  id        Int      @id @default(autoincrement())
  email     String
  dropId    Int?
  drop      Drop?    @relation(fields: [dropId], references: [id], onDelete: Cascade)
  creatorId Int?     // Notify for all drops from this creator
  creator   Creator? @relation("CreatorNotifications", fields: [creatorId], references: [id])
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([email, dropId])
  @@index([email])
}
